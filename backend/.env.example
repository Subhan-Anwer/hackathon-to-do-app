# Multi-User Task Management API - Environment Variables

# Database Configuration (Neon PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/database?ssl=require

# Better Auth JWT Secret (MUST match frontend .env)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# Frontend Origin (for CORS configuration)
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:3000
